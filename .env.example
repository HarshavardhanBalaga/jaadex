# Shared MongoDB Atlas cluster — same URI format in every environment.
# The database name is what separates environments.
# NEVER commit real credentials. Production values belong in the host secret manager.

# e.g. mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/

# Per-environment database name:
#   development -> jaadex_development
#   production  -> jaadex_production
#   test        -> jaadex_test
MONGODB_DB_NAME=jaadex_development

# NODE_ENV is set by Next.js (development/production) or the test runner (test).
# NODE_ENV=development

# ---- Admin auth (server-only; never prefix with NEXT_PUBLIC_) ----
# Each secret >= 32 chars; all three must differ.
JWT_ACCESS_SECRET=<64-hex-chars-min-32>
JWT_REFRESH_SECRET=<different-64-hex-chars-min-32>
OTP_PEPPER=<different-64-hex-chars-min-32>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=jaadex-admin
JWT_AUDIENCE=jaadex-admin-portal

# OTP policy
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Bootstrap recipient: registration email must match this; OTP is sent ONLY here.
ADMIN_OTP_EMAIL=admin@example.com

# SMTP for OTP mail
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
MAIL_FROM=JaaDeX Admin <no-reply@example.com>

# URLs + proxy
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# true only when behind a trusted reverse proxy (Vercel/nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

# Google sign-in (optional; button is hidden when empty). Google Cloud Console ->
# Credentials -> OAuth client ID (Web application). Authorized redirect URI:
#   <APP_URL>/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


